{
  "$schema": "https://raw.githubusercontent.com/nicholasrice/tauri-v2-schema/master/tauri.schema.json",
  "productName": "Nuvio TV",
  "version": "0.1.3",
  "identifier": "com.nuviomedia.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run serve",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Nuvio TV",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzODVGNDc1Q0NBOEMwMzMKUldRendLak1kZlNGNDd4bnNqajYyTnFCWEg2Vjg0dDNib1VXM3FBbnc0UEN2UWk2L1o4blRpbVUK",
      "endpoints": [
        "https://github.com/CaullenOmdahl/NuvioWeb/releases/latest/download/latest.json"
      ]
    }
  }
}
